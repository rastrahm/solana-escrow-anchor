{
  "name": "solana-escrow-anchor",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build:program": "bash scripts/build-program.sh",
    "test:program": "npm run build:program && anchor test --skip-build",
    "test:layout": "cargo test -p escrow --lib layout_tests",
    "harden:check": "bash scripts/harden-check.sh",
    "test:harden": "npm run harden:check && npm run test:layout && npm run test:program",
    "build:frontend": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:frontend": "npm --prefix frontend test",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
